rules_version = '2';

// Deny-all. Firestore is only ever accessed via the firebase-admin SDK from
// Server Components/Server Actions (which bypasses these rules entirely) —
// the browser never talks to Firestore directly. This file is defense in
// depth against an accidental future client-SDK import, not the real
// access control.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
