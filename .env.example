# firebase-admin (service account) — server-only, never exposed to the browser
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Identity Toolkit REST API key — used server-side only (no client SDK is used)
FIREBASE_WEB_API_KEY=

# One-time seed script input only (scripts/seed-admin.ts) — not read by the running app
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
